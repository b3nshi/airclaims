      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load config').first().json.supabase_url }}/storage/v1/object/sign/claim-documents",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ expiresIn: 300, paths: ($json.attachments || []).map(a => a.storage_path) }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
