    {
      "id": "d88c053b-aace-5916-8d37-f84279901a44",
      "name": "Build message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        120
      ],
      "parameters": {
        "jsCode": "// Forward Email API payload for one approved email. Attachments are downloaded through\n// short-lived signed URLs, so the Storage service key stays in the n8n credential.\nconst cfg = $('Load config').first().json;\nconst e = $('Has email?').item.json;\nconst signed = Array.isArray($json.body) ? $json.body : [];\nconst messageId = `<${e.id}@airclaims.klivr.com>`; // unique per email; stored for threading\ntry {\n  const attachments = [];\n  for (const a of e.attachments || []) {\n    const s = signed.find((x) => x.path === a.storage_path && x.signedURL);\n    if (!s) throw new Error(`no signed URL for ${a.filename}`);\n    const data = await this.helpers.httpRequest({ url: `${cfg.supabase_url}/storage/v1${s.signedURL}`, encoding: 'arraybuffer' });\n    attachments.push({ filename: a.filename, content: Buffer.from(data).toString('base64'), encoding: 'base64', contentType: a.mime || undefined });\n  }\n  const name = String(e.sender_name || '').replace(/[\"<>\\r\\n]/g, '').trim();\n  const payload = {\n    from: name ? `\"${name}\" <${e.from_address}>` : e.from_address,\n    to: e.to_addresses,\n    replyTo: e.from_address,\n    subject: e.subject,\n    text: e.body_text,\n    messageId,\n    attachments,\n  };\n  if (e.cc_addresses && e.cc_addresses.length) payload.cc = e.cc_addresses;\n  if (e.in_reply_to) Object.assign(payload, { inReplyTo: e.in_reply_to, references: e.in_reply_to });\n  return { json: { email_id: e.id, ready: true, message_id: messageId, payload } };\n} catch (err) {\n  return { json: { email_id: e.id, ready: false, error: `attachments: ${String(err && err.message || err).slice(0, 300)}` } };\n}\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "62434378-a4d6-5585-9d61-bab6ca367439",
      "name": "Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2200,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "6ed6c04c-fe6a-5211-84bd-d4959ac60319",
              "leftValue": "={{ $json.ready }}",
              "rightValue": "",
