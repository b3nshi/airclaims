    {
      "id": "ce1184f1-e290-516d-b8fa-e1c77f080186",
      "name": "Send via Forward Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        40
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load config').first().json.forwardemail_api_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 60000
        }
      },
      "credentials": {
        "httpBasicAuth": {
          "id": "",
          "name": "Forward Email API"
        }
      }
    },
    {
      "id": "6156bf2d-25f2-5b90-98b4-cbcb3ab5f65e",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        40
      ],
      "parameters": {
        "jsCode": "// Any non-2xx is a failure. It is never retried automatically: it may have gone out.\nconst built = $('Build message').item.json;\nconst code = $json.statusCode;\nif (code >= 200 && code < 300) {\n  return { json: { email_id: built.email_id, ok: true, message_id: ($json.body && $json.body.messageId) || built.message_id } };\n}\nconst detail = String(($json.body && ($json.body.message || $json.body.error)) || '').slice(0, 300);\nreturn { json: { email_id: built.email_id, ok: false, error: `forwardemail_http_${code}: ${detail}` } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "5b86e296-5179-598f-a4f9-237bc6b99ace",
      "name": "Sent?",
      "type": "n8n-nodes-base.if",
