    {
      "id": "cfdd111a-ee7d-5eeb-99ff-daf074a3367d",
      "name": "AeroDataBox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        120
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://aerodatabox.p.rapidapi.com/flights/number/{{ $json.flight_iata }}/{{ $json.flight_date }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "withAircraftImage",
              "value": "false"
            },
            {
              "name": "withLocation",
              "value": "false"
            },
            {
              "name": "dateLocalRole",
              "value": "Departure"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Host",
              "value": "aerodatabox.p.rapidapi.com"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 10000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1100
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "AeroDataBox (RapidAPI key)"
        }
      }
    },
    {
      "id": "c1cb3672-7682-5558-8a39-698ae1aa3869",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        120
      ],
      "parameters": {
        "jsCode": "// One AeroDataBox response → complete (found / not found) or fail (no data received).\n// actual_arr is the API's revised/runway time; the legal reference (doors open) is\n// confirmed by the passenger in the wizard.\nconst check = $('Has check?').item.json;\nconst res = $json;\nconst code = res.statusCode;\nconst list = Array.isArray(res.body) ? res.body : [];\n\nif (code === 200 && list.length) {\n  const f = list.find((x) => (x.departure?.scheduledTime?.local || '').startsWith(check.flight_date)) || list[0];\n  const iso = (t) => (t?.utc ? new Date(t.utc.replace(' ', 'T')).toISOString() : null);\n  const arrived = /arrived/i.test(f.status || '');\n  return {\n    json: {\n      check_id: check.id,\n      outcome: 'found',\n      flight: {\n        dep_iata: f.departure?.airport?.iata || null,\n        arr_iata: f.arrival?.airport?.iata || null,\n        airline_iata: f.airline?.iata || null,\n        scheduled_dep: iso(f.departure?.scheduledTime),\n        actual_dep: iso(f.departure?.runwayTime || f.departure?.revisedTime),\n        scheduled_arr: iso(f.arrival?.scheduledTime),\n        actual_arr: arrived ? iso(f.arrival?.revisedTime || f.arrival?.runwayTime) : null,\n        status: f.status || null,\n        distance_km: f.greatCircleDistance?.km ? Math.round(f.greatCircleDistance.km) : null,\n      },\n      raw: f,\n    },\n  };\n}\nif (code === 204 || code === 404 || (code === 200 && !list.length)) {\n  return { json: { check_id: check.id, outcome: 'not_found' } };\n}\nreturn { json: { check_id: check.id, outcome: 'error', error: `HTTP ${code}` } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "7883dabb-d67f-597c-917f-6d776e9eb735",
      "name": "Got data?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2200,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "3ea16d09-fdb3-52ef-87cd-597f12efd319",
              "leftValue": "={{ $json.outcome }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "cabd5b7c-5608-5871-8a59-3b62e0bc444a",
      "name": "Complete check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        40
      ],
      "parameters": {
