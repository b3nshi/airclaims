    {
      "id": "cfa822c4-4338-4c71-8045-79a7d78a187b",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "jsCode": "// Verifies X-AirClaims-Signature = sha256=HMAC(secret, `${timestamp}.${rawBody}`).\n// Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto and AIRCLAIMS_WEBHOOK_SECRET in n8n's env.\nconst crypto = require('crypto');\nconst headers = $input.first().json.headers || {};\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst ts = String(headers['x-airclaims-timestamp'] || '');\nconst sig = String(headers['x-airclaims-signature'] || '');\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.AIRCLAIMS_WEBHOOK_SECRET).update(`${ts}.${raw}`).digest('hex');\nconst fresh = Math.abs(Date.now() / 1000 - Number(ts)) <= 300;\nconst valid = fresh && sig.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(expected));\nreturn [{ json: { valid } }];"
      }
    },
    {
      "id": "09eea38b-48f4-4ba0-b283-51d52dff71f8",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "6b1cade1-f64d-4ce9-a7c4-d7d46e416505",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e12e7922-fb68-4f76-b6a9-df9d2f6c53ff",
