{
  "name": "airclaim-flight-check",
  "nodes": [
    {
      "id": "360740d7-c94b-51c8-9615-6d6e6cd57a55",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "airclaim-flight-check",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "5c7a8ed6-5276-56eb-906b-7b37a699f452"
    },
    {
      "id": "475d0937-75d3-5105-9519-fb74607ab581",
      "name": "Read request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "jsCode": "// Raw webhook request → the fields verify_webhook_signature checks in Supabase against the\n// Vault secret. No secret lives in n8n. The Webhook node must have \"Raw Body\" enabled.\nconst headers = $input.first().json.headers || {};\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nreturn [{\n  json: {\n    timestamp: String(headers['x-airclaims-timestamp'] || ''),\n    signature: String(headers['x-airclaims-signature'] || ''),\n    idempotency_key: String(headers['x-airclaims-idempotency-key'] || ''),\n    raw,\n  },\n}];\n"
      }
    },
    {
      "id": "02fe1fed-e55d-5188-8c92-f54e0313e325",
      "name": "Load config",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        400,
        300
      ],
      "parameters": {
        "source": "database",
        "mode": "once",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "airclaim-config"
        },
        "options": {}
      }
    },
    {
      "id": "ec55e8de-ed6c-5146-9844-b1581e8146de",
      "name": "Verify signature",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load config').first().json.supabase_url }}/rest/v1/rpc/verify_webhook_signature",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_timestamp: $('Read request').first().json.timestamp, p_body: $('Read request').first().json.raw, p_signature: $('Read request').first().json.signature }) }}",
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "AirClaims Supabase (service role)"
        }
      }
    },
    {
      "id": "c998a8d1-2d2e-5987-ac56-4d8cb44f3e92",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "07f71934-9773-5937-9083-75287bda940d",
      "name": "From webhook?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "64ff0eba-eecf-5ed8-a064-83045987cfcb",
              "leftValue": "={{ $('Read request').isExecuted }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "11993f4d-7185-5504-8ef3-cca71285d7b5",
      "name": "Valid?",
