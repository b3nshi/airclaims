        "url": "={{ $('Load config').first().json.supabase_url }}/rest/v1/rpc/complete_flight_check",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_check_id: $json.check_id, p_found: $json.outcome === 'found', p_flight: $json.flight ?? null, p_raw: $json.raw ?? null }) }}",
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "AirClaims Supabase (service role)"
        }
      }
    },
    {
      "id": "2ef83a0e-4b36-538e-a502-631628d4b454",
      "name": "Fail check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load config').first().json.supabase_url }}/rest/v1/rpc/fail_flight_check",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_check_id: $json.check_id, p_error: $json.error }) }}",
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "",
          "name": "AirClaims Supabase (service role)"
        }
      }
    }
  ],
