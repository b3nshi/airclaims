# ---------------------------------------------------------------------------
# AirClaims web app — copy to .env.local for local dev; set the same keys in
# Vercel (Production + Preview) for deploys. Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL of this app, no trailing slash. Used to build magic-link
# redirects, so it must also be listed in Supabase → Auth → URL Configuration.
#   local:      http://localhost:3000
#   production: https://airclaims.klivr.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (EU region). Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Browser-safe key (the "anon" or "publishable" key). Every query it makes is
# subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_, never import from
# client components. Not used by the app in M1; reserved for server-side admin
# tasks. n8n holds its own copy.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY — n8n integration (used from M2). The app calls
# ${N8N_WEBHOOK_BASE_URL}/airclaim-* webhooks, signing each body with
# HMAC-SHA256(N8N_WEBHOOK_SECRET). The same secret is configured in n8n.
# Generate with: openssl rand -hex 32
N8N_WEBHOOK_BASE_URL=https://labs.klivr.com/webhook
N8N_WEBHOOK_SECRET=

# Secrets that live in n8n credentials, NOT here: Anthropic API key,
# AeroDataBox / Aviationstack keys, Forward Email SMTP credentials.
